{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "server/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/demo/index.html" },
    { "source": "/v1/(.*)", "destination": "/api/index.py" }
  ],
  "headers": [
    {
      "source": "/extension/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60" }]
    }
  ]
}
